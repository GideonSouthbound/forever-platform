# Warcraft Logs API v2 — create a client at https://www.warcraftlogs.com/api/clients/
WCL_CLIENT_ID=
WCL_CLIENT_SECRET=
# Classic Era host. Fallback: https://classic.warcraftlogs.com/api/v2/client
WCL_API_HOST=https://vanilla.warcraftlogs.com/api/v2/client
WCL_TOKEN_URL=https://www.warcraftlogs.com/oauth/token
# Platform (not PoC): private API + OAuth for account linking
# WCL_USER_API_HOST=https://www.warcraftlogs.com/api/v2/user
# WCL_AUTHORIZE_URL=https://www.warcraftlogs.com/oauth/authorize
# WCL_REDIRECT_URI=https://<your-domain>/api/auth/wcl/callback
# Stop jobs at this share of the hourly point limit
WCL_RATE_LIMIT_STOP_PCT=0.85

# Postgres (Replit provides DATABASE_URL automatically)
DATABASE_URL=

# Second data-source adapter (pattern proof only)
TALENTS_FOREVER_URL=https://talentsforever.com/data.json
TALENTS_POLL_MINUTES=60

# Reference sample size per band per boss per spec (start small)
SAMPLE_PER_BAND=20
